{
  "name": "demo-angular",
  "version": "1.0.34",
  "scripts": {
    "ng": "ng",
    "start": "npm run use:local && ng serve -o",
    "build": "ng build",
    "build:prod": "npm run use:npm && ng build --configuration production",
    "deploy": "ng deploy --base-href=/dga-ui/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "use:local": "npm install --no-save file:.. && echo Using local sdga-ui",
    "use:npm": "node -e \"const fs=require('fs');const pkg=JSON.parse(fs.readFileSync('package.json'));const version=pkg.dependencies['sdga-ui'];console.log('Installing sdga-ui@'+version);\" && npm install && echo Using npm sdga-ui"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@parcel/watcher": "^2.5.1",
    "bootstrap": "^5.3.8",
    "highlight.js": "^11.12.0",
    "rxjs": "~7.8.2",
    "sdga-ui": "^1.0.35",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.5.1": true,
    "fsevents@2.3.3": true
  }
}
